                "kind": "script",
                "lines": [
                  {
                    "who": "RODERIGO",
                    "line": "I would not follow him, then."
                  },
                  {
                    "who": "IAGO",
                    "line": "O, sir, content you."
                  },
                  {
                    "who": null,
                    "line": "I follow him to serve my turn upon him."
                  },
                  {
                    "who": null,
                    "line": "We cannot all be masters, nor all masters"
                  },
                  {
                    "who": null,
                    "line": "Cannot be truly followed. (lines 45–47)"
                  },
                  {
                    "who": null,
                    "line": "...It is as sure as you are Roderigo,"
                  },
                  {
                    "who": null,
                    "line": "Were I the Moor I would not be Iago."
                  },
                  {
                    "who": null,
                    "line": "In following him, I follow but myself."
                  },
                  {
                    "who": null,
                    "line": "Heaven is my judge, not I for love and duty,"
                  },
                  {
                    "who": null,
                    "line": "But seeming so for my peculiar end."
                  },
                  {
                    "who": null,
                    "line": "For when my outward action doth demonstrate"
                  },
                  {
                    "who": null,
                    "line": "The native act and figure of my heart"
                  },
                  {
                    "who": null,
                    "line": "In complement extern, 'tis not long after"
                  },
                  {
                    "who": null,
                    "line": "But I will wear my heart upon my sleeve"
                  },
                  {
                    "who": null,
                    "line": "For daws to peck at. I am not what I am."
                  }
                ]
              }
            ],
            "source_refs": [
